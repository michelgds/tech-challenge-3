            "url": { "raw": "{{agendamentoBaseUrl}}/graphql", "host": ["{{agendamentoBaseUrl}}"], "path": ["graphql"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query { historicoPorPaciente(pacienteId: \\\"{{pacienteId}}\\\") { id pacienteId medicoId dataHora status observacoes } }\"\n}"
